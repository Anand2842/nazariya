# Local Postgres started by `npm run db:start` (port 54329, data in ./.pgdata)
DATABASE_URL=postgres://nazariya@localhost:54329/nazariya
DATABASE_URL_TEST=postgres://nazariya@localhost:54329/nazariya_test
# Public base URL used for share links / OG tags
APP_URL=http://localhost:3100
# Local object storage root (production: R2/S3 driver)
STORAGE_DIR=./storage
# DEV ONLY: echo OTP codes in API responses and show the dev outbox. Never enable in production.
DEV_TOOLS=1
# Secret used to sign session tokens
SESSION_SECRET=change-me-in-production-32-bytes-min
# Optional: external reconstruction command for phone-video 3D (GPU worker). Receives <framesDir> <outDir>.
# NAZARIYA_RECON_CMD=
# OTP requests per phone per hour. Production: leave unset (default 6). Local e2e runs log in many times.
# OTP_MAX_PER_HOUR=6
